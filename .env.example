# ==========================================================
# Variables de entorno para ms-andesstay-catalog (Docker Desktop)
# Copia este archivo a .env y ajusta los valores necesarios
# ==========================================================

# Base de datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AWS Cognito (User Pool)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_CHANGE_ME
COGNITO_APP_CLIENT_ID=CHANGE_ME

# Origen permitido para CORS (Frontend Angular)
FRONTEND_URL=http://localhost:4200
CORS_ENABLED=true

